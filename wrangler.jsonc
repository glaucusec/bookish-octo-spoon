{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-18",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "plantidentifier-online",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"routes": [
		{
			"pattern": "plantidentifier.online",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
