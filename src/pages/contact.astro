---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Plant Identifier" description="Contact the Plant Identifier team with feedback, corrections or questions." canonicalPath="/contact/">
  <section class="page-hero"><div class="container"><p class="eyebrow">Contact</p><h1>Questions are welcome.</h1><p class="hero-lede" style="margin-left:0">Found a problem, have a correction, or want to share feedback? Email <a href="mailto:hello@plantidentifier.online">hello@plantidentifier.online</a>.</p></div></section>
  <section class="section-tight"><div class="container prose"><p>Include the page you were using, what you expected and what happened. Do not email sensitive images or information. We cannot provide urgent poisoning, medical or veterinary advice.</p></div></section>
</Layout>
