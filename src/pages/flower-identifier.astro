---
import Layout from '../layouts/Layout.astro'; import IdentifierLanding from '../components/IdentifierLanding.astro';
---
<Layout title="Flower Identifier by Photo — Identify Flowers Free" description="Upload flower photos and get likely plant species matches online. Free to use with no app install or account." canonicalPath="/flower-identifier/">
  <IdentifierLanding eyebrow="Flower identifier" title="Meet the flower in front of you." intro="Use a clear bloom photo plus the leaves and whole plant. Color helps, but petal shape and structure usually tell us more." tips={["Photograph one open bloom from the front without cropping its petals.","Add a side view showing the flower base and how it joins the stem.","Include leaves and the whole plant so the match is not based on color alone."]} />
</Layout>
