---
import Layout from '../layouts/Layout.astro'; import IdentifierLanding from '../components/IdentifierLanding.astro';
---
<Layout title="Leaf Identifier by Photo — Free Online Plant Tool" description="Identify a plant from a leaf photo. Upload clear leaf and whole-plant images for free species matches and confidence scores." canonicalPath="/leaf-identifier/">
  <IdentifierLanding eyebrow="Leaf identifier" title="Put a name to that leaf." intro="Leaf shape, edges, veins and stem attachment all leave clues. Add a whole-plant view alongside your close-up for a stronger identification." tips={["Place one healthy leaf against a plain background without removing it if possible.","Keep the leaf edge, tip and base visible in the frame.","Add a second photo showing how leaves are arranged along the stem."]} />
</Layout>
